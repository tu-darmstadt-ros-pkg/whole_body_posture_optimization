<?xml version="1.0"?>
<launch>
  <arg name="rviz" default="false"/>
  <!-- Load robot description -->
  <param name="robot_description" command="$(find xacro)/xacro $(find asterix_description)/urdf/asterix_ugv.urdf.xacro" />
  <param name="robot_description_semantic" textfile="$(find asterix_moveit_config)/config/asterix_ugv.srdf" />
  
  <node pkg="whole_body_posture_optimization" type="whole_body_posture_optimization_node" name="whole_body_posture_optimization_node" output="screen" clear_params="true" ><!--launch-prefix="gdb -args"-->
    <!-- load scenario -->
    <rosparam subst_value="true" ns="sdf_map">
<!--       scenario: step_0.18 -->
      voxel_size: 0.05
      use_esdf: true
<!--       sdf_file_path: $(find sdf_contact_estimation)/sdf/gazebo_step.esdf -->
<!--       sdf_file_path: $(find sdf_contact_estimation)/sdf/gazebo_ramp.esdf -->
<!--       sdf_file_path: $(find sdf_contact_estimation)/sdf/gazebo_cinder_block.esdf -->
<!--       sdf_file_path: $(find sdf_contact_estimation)/sdf/gazebo_man6.esdf -->
<!--       sdf_file_path: $(find sdf_contact_estimation)/sdf/gazebo_obs2_hurdles_0_05.esdf -->
      sdf_file_path: $(find whole_body_planning_data)/sdf/gazebo/gazebo_oc_pallet_terrain2.esdf
      truncation_distance: 0.4
    </rosparam>

    <rosparam subst_value="true" ns="heightmap">
      map_bag_file_path: $(find whole_body_planning_data)/heightmap/gazebo_pallet_parcours.whm
    </rosparam>

<!--    <param name="path_start" value="3.0"/>
    <param name="path_stop" value="5.0"/>
    <param name="path_step" value="0.02"/>-->

    <param name="trajectory_statistics_save_folder" value="$(find whole_body_planning_plotting_utils)/data/trajectory_plan"/>
    
    <!-- posture optimization lib parameters -->
    <param name="stepping" value="false"/>
    <param name="stepping_start" value="0"/>
    <rosparam file="$(find whole_body_posture_optimization)/config/opt_asterix.yaml" command="load" />  
    
    <!-- pose predictor parameters -->
    <param name="pose_predictor" value="sdf_contact_estimation::SDFContactEstimation"/>
<!--     <param name="pose_predictor" value="hector_heightmap_pose_prediction::HeightmapPosePredictor"/> -->

    <rosparam file="$(find sdf_contact_estimation)/config/optimization.yaml" command="load" ns="sdf_pose_predictor"/>
    <rosparam file="$(find sdf_contact_estimation)/config/support_polygon_asterix.yaml" command="load" ns="sdf_pose_predictor"/>
    <rosparam file="$(find sdf_contact_estimation)/config/asterix_shape_config.yaml" command="load" ns="sdf_pose_predictor/shape_model" />
  </node>

  <!-- moveit parameters -->
  <group ns="robot_description_planning">
    <rosparam command="load" file="$(find asterix_moveit_config)/config/joint_limits.yaml"/>
    <rosparam command="load" file="$(find asterix_moveit_config)/config/joint_limits_world.yaml"/>
  </group>

  <!-- rviz ui -->
  <include if="$(arg rviz)" file="$(find whole_body_posture_optimization)/launch/rviz.launch"/>

</launch>

<?xml version="1.0"?>
<launch>    
  <!-- Load robot description -->
  <param name="robot_description" command="$(find xacro)/xacro $(find asterix_description)/urdf/asterix_ugv.urdf.xacro" />
  <param name="robot_description_semantic" textfile="$(find asterix_moveit_config)/config/asterix_ugv.srdf" />
  
  <node pkg="whole_body_posture_optimization" type="whole_body_posture_optimization_node" name="whole_body_posture_optimization_node" output="screen" clear_params="true">
    <!-- load scenario -->
    <rosparam subst_value="true" ns="sdf_map">
      #scenario: step
      #voxel_size: 0.05
      use_esdf: true
      sdf_file_path: $(find sdf_contact_estimation)/sdf/gazebo_step.esdf
      truncation_distance: 0.4
    </rosparam>

    <param name="path_start" value="0"/>
    <param name="path_stop" value="2.5"/>
    <param name="path_step" value="0.02"/>

    <param name="stability_info_save_folder" value="$(find whole_body_posture_optimization)/data/planning"/>
    
    <!-- posture optimization lib parameters -->
    <param name="stepping" value="false"/>
    <param name="stepping_start" value="0"/>
    <rosparam file="$(find whole_body_posture_optimization)/config/opt_asterix.yaml" command="load" />  
    
    <!-- sdf contact estimation lib parameters -->
    <rosparam file="$(find sdf_contact_estimation)/config/optimization.yaml" command="load" ns="pose_predictor"/>
    <rosparam file="$(find sdf_contact_estimation)/config/asterix_shape_config.yaml" command="load" ns="pose_predictor/shape_model" />
  </node>
</launch>

<?xml version="1.0"?>
<launch>
  <arg name="telemax_config" default="telemax"/>
  <!-- Load robot description -->
  <param name="robot_description" command="$(find xacro)/xacro $(find drz_telemax_description)/urdf/drz_telemax_complete.urdf.xacro" />
  <param name="robot_description_semantic" textfile="$(find drz_telemax_moveit_config)/config/drz_telemax.srdf" />
  
  <!-- Joint state UI -->
  <rosparam subst_value="true">
    zeros:
    zeros:
      arm_joint_1: -2
      arm_joint_2: 1.2
      arm_joint_4: 1
  </rosparam>
  <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" />

  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
    <param name="use_tf_static" value="true" />
  </node>
  
  
  <!-- Whole-body posture optimization -->
  <node pkg="whole_body_posture_optimization" type="com_visualisation_node" name="com_visualisation_node" output="screen" clear_params="true">
    <rosparam file="$(find whole_body_posture_optimization)/config/opt_$(arg telemax_config).yaml" command="load" />

    <!-- sdf contact estimation lib parameters -->
    <rosparam file="$(find sdf_contact_estimation)/config/$(arg telemax_config)_shape_config.yaml" command="load" ns="pose_predictor/shape_model" />
  </node>

  <node name="$(anon rviz)" pkg="rviz" type="rviz" args="-d $(find whole_body_posture_optimization)/rviz/com_visualization.rviz" output="screen"/>

</launch>

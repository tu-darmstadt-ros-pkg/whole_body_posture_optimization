<?xml version="1.0"?>
<launch>  
  <!-- Load robot description -->
  <param name="robot_description" command="$(find xacro)/xacro $(find asterix_description)/urdf/asterix_ugv.urdf.xacro" />
  <param name="robot_description_semantic" textfile="$(find asterix_moveit_config)/config/asterix_ugv.srdf" />
  
  <!-- Whole-body posture optimization -->
  <node pkg="whole_body_posture_optimization" type="optimization_logging_node" name="whole_body_posture_optimization_node" output="screen" clear_params="true">
    <!-- node parameters -->
    <rosparam subst_value="true">
     robot_pose: [-1.82,0,0,0,0,0]
<!--       robot_pose: [0.680000, 0.000000, 0.206300, -0.008606, -0.553678, 0.000000] # gazebo step -> why is the back flipper not used to climb up the step? -->
<!--       robot_pose: [1.015649, 0.000000, 0.475015, 0.000000, -0.000000, 0.000000] # real robot cinder block ->  why is the back flipper not used to climb up the step? -->
    </rosparam>
    
    <!-- load scenario -->
    <rosparam subst_value="true" ns="sdf_map">
      scenario: step_0.25
      #voxel_size: 0.05
      use_esdf: true
<!--       sdf_file_path: $(find sdf_contact_estimation)/sdf/gazebo_step.esdf -->
<!--       sdf_file_path: $(find sdf_contact_estimation)/sdf/gazebo_ramp.esdf- -->
<!--       sdf_file_path: $(find sdf_contact_estimation)/sdf/gazebo_cinder_block.esdf -->
<!--       sdf_file_path: $(find sdf_contact_estimation)/sdf/gazebo_man6.esdf -->
      sdf_file_path: $(find sdf_contact_estimation)/sdf/gazebo_obs2_hurdles.esdf
      truncation_distance: 0.4
    </rosparam>

    <param name="logging_folder" value="$(find whole_body_planning_plotting_utils)/data/cost_functions"/>

    <!-- posture optimization lib parameters -->
    <param name="stepping" value="false"/>
    <param name="stepping_start" value="0"/>
    <rosparam file="$(find whole_body_posture_optimization)/config/opt_asterix.yaml" command="load" />

    <!-- sdf contact estimation lib parameters -->
    <rosparam file="$(find sdf_contact_estimation)/config/optimization.yaml" command="load" ns="pose_predictor"/>
    <rosparam file="$(find sdf_contact_estimation)/config/asterix_shape_config.yaml" command="load" ns="pose_predictor/shape_model" />
  </node>

  <!-- rviz ui -->
  <include file="$(find whole_body_posture_optimization)/launch/rviz.launch"/>
</launch>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>whole_body_posture_optimization</name>
  <version>2.0.0</version>
  <description>Optimization of the robot posture for robustness (stability, traction, ..) while following a path.</description>

  <maintainer email="ros@martinoehler.de">Martin Oehler</maintainer>
  <author email="ros@martinoehler.de">Martin Oehler</author>

  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>hector_pose_prediction_interface</depend>
  <depend>hector_pose_prediction_ros</depend>
  <depend>sdf_contact_estimation</depend>
  <depend>whole_body_planning_plotting_utils</depend>
  <depend>urdf</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>ad_kinematics</depend>
  <depend>ceres_nlopt_wrapper</depend>
  <depend>libceres-dev</depend>
  <depend>nlopt</depend>
  <depend>hector_stability_metrics</depend>
  <depend>voxblox</depend>
  <depend>voxblox_ros</depend>
  <depend>voxblox_msgs</depend>
  <depend>tf2_eigen</depend>
  <depend>pluginlib</depend>
  <exec_depend>nav2_msgs</exec_depend>

  <!-- Optional heightmap pose prediction support (build with -DWITH_HEIGHTMAP_POSE_PREDICTION=ON):
       requires hector_heightmap_pose_prediction, hector_world_heightmap,
       hector_world_heightmap_ros and grid_map_msgs (not yet ported to ROS 2). -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

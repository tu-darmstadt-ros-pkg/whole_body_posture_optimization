<?xml version="1.0"?>
<launch>
  <arg name="log_folder"/>

  <node pkg="rosbag" type="record" name="rosbag_record_standard_data" respawn="true" output="screen"
        args="--repeat-latched -o $(arg log_folder)/obstacle_traversal_record
          /tf
          /tf_static
          /joint_states
          /imu/data
          /odom
          /odom_raw
          /cmd_vel
          /cmd_vel_raw
          /robot_pose
        "
/>

</launch>

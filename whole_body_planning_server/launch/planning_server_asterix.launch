<?xml version="1.0"?>
<launch>  
  <node pkg="whole_body_planning_server" type="whole_body_planning_server_node" name="whole_body_planning_server" output="screen" clear_params="true">
<!--  <node pkg="whole_body_planning_server" type="whole_body_planning_server_node" name="whole_body_planning_server" output="screen" launch-prefix="gdb-args">-->
    <param name="auto_start" value="false"/>
    <param name="continuous_replanning" value="false"/>
    <param name="base_frame" value="base_link"/>
    <param name="path_sampling_resolution" value="0.05"/>
    
    <!-- posture optimization lib parameters -->
    <rosparam file="$(find whole_body_posture_optimization)/config/opt_asterix.yaml" command="load" />

    <!-- sdf contact estimation lib parameters -->
    <rosparam file="$(find sdf_contact_estimation)/config/optimization.yaml" command="load" ns="pose_predictor"/>
    <rosparam file="$(find sdf_contact_estimation)/config/asterix_shape_config.yaml" command="load" ns="pose_predictor/shape_model" />
    
    <param name="stability_info_save_folder" value="$(find whole_body_posture_optimization)/data/planning"/>

    <!-- esdf server parameters -->
    <rosparam file="$(find whole_body_planning_server)/config/esdf_server_common.yaml" command="load" ns="esdf_server"/>
    <param name="esdf_server/update_mesh_every_n_sec" value="0.0"/>
    <remap from="~/esdf_server/esdf_map_in" to="/esdf_server/esdf_map_out" />
  </node>

  <!-- moveit_cpp parameters -->
  <rosparam ns="whole_body_planning_server" file="$(find whole_body_planning_server)/config/moveit_cpp.yaml" command="load"/>

  <!-- Planning Pipeline -->
  <include ns="whole_body_planning_server/ompl" file="$(find asterix_moveit_config)/launch/ompl_planning_pipeline.launch.xml"/>

  <!-- Trajectory execution  -->
  <include ns="whole_body_planning_server" file="$(find asterix_moveit_config)/launch/trajectory_execution.launch.xml"/>


  <!-- Debug -->
<!--   <node pkg="rosservice" type="rosservice" name="set_ceres_nlopt_wrapper_log_level" args="call wait /whole_body_planning_server/set_logger_level 'ros.ceres_nlopt_wrapper' 'debug'" /> -->
</launch>

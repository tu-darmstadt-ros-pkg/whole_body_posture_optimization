<?xml version="1.0"?>
<launch>
  <env name="ROSCONSOLE_CONFIG_FILE" value="$(find whole_body_planning_server)/config/rosconsole.config"/>
  <node pkg="whole_body_planning_server" type="whole_body_planning_server_node" name="whole_body_planning_server" output="screen" clear_params="true" respawn="true">
<!--  <node pkg="whole_body_planning_server" type="whole_body_planning_server_node" name="whole_body_planning_server" output="screen" launch-prefix="gdb -args">-->
    <param name="auto_start" value="true"/>
    <param name="override_path_time" value="false"/>
    <param name="base_frame" value="base_link"/>
    <param name="path_sampling_resolution" value="0.05"/>
    <param name="planning_horizon" value="0.5"/>

    <param name="continuous_planning" value="true"/>
    <param name="execution_position_tolerance" value="0.0"/>
    <param name="execution_orientation_tolerance" value="0.0"/>
    <param name="minimum_path_length" value="0.2"/>

    <!-- posture optimization lib parameters -->
    <rosparam file="$(find whole_body_posture_optimization)/config/opt_asterix.yaml" command="load" />

    <!-- sdf contact estimation lib parameters -->
    <rosparam file="$(find sdf_contact_estimation)/config/optimization.yaml" command="load" ns="pose_predictor"/>
    <rosparam file="$(find sdf_contact_estimation)/config/support_polygon_asterix.yaml" command="load" ns="pose_predictor"/>
    <rosparam file="$(find sdf_contact_estimation)/config/asterix_shape_config.yaml" command="load" ns="pose_predictor/shape_model" />
    
    <param name="trajectory_statistics_save_folder" value="$(find whole_body_planning_plotting_utils)/data/trajectory_plan"/>

    <!-- esdf server parameters -->
    <rosparam file="$(find hector_sensor_proc_launch)/config/voxblox_common_config.yaml" command="load" ns="esdf_server"/>
    <param name="esdf_server/update_mesh_every_n_sec" value="0.0"/>
    <remap from="~/esdf_server/esdf_map_in" to="/esdf_server/esdf_map_out" />
  </node>

  <!-- moveit_cpp parameters -->
  <rosparam ns="whole_body_planning_server" file="$(find whole_body_planning_server)/config/moveit_cpp.yaml" command="load"/>

  <!-- moveit parameters -->
  <group ns="robot_description_planning">
    <rosparam command="load" file="$(find asterix_moveit_config)/config/joint_limits.yaml"/>
    <rosparam command="load" file="$(find asterix_moveit_config)/config/joint_limits_world.yaml"/>
  </group>

  <!-- Planning Pipeline -->
  <include ns="whole_body_planning_server/ompl" file="$(find asterix_moveit_config)/launch/ompl_planning_pipeline.launch.xml"/>

  <!-- Trajectory execution  -->
  <include ns="whole_body_planning_server" file="$(find asterix_moveit_config)/launch/trajectory_execution.launch.xml"/>
</launch>

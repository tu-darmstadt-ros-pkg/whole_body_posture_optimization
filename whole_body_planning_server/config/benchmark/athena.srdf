<?xml version="1.0"?>
<!-- Planning groups of the benchmark's Athena (athena_description in benchmark_robot): four flippers, no arm. -->
<robot name="athena">
  <virtual_joint name="world_virtual_joint" type="floating" parent_frame="map" child_link="base_footprint_link"/>
  <group name="flipper_group">
    <joint name="flipper_fl_joint"/>
    <joint name="flipper_fr_joint"/>
    <joint name="flipper_bl_joint"/>
    <joint name="flipper_br_joint"/>
  </group>
</robot>

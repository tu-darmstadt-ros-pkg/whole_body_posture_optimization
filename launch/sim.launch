<?xml version="1.0"?>

<launch>
  
  <arg name="robot_type" default="argo_tracker" />
  <arg name="lidar_filter_target_frame" default="odom"/>

  <arg name="spawn_x_pos" default="0" />
  <arg name="spawn_y_pos" default="0" />
  <arg name="spawn_z_pos" default="0" />
  <arg name="spawn_roll"  default="0.0" />
  <arg name="spawn_pitch" default="0.0" />    
  <arg name="spawn_yaw"   default="0" />
  
  <arg name="world" default="$(find whole_body_posture_optimization)/worlds/step_test.world"/>


<!--  <include file="$(find argo_sim_scenario_launch)/launch/argo_sim_common.launch">
    <arg name="robot_type" value="$(arg robot_type)"/>
    <arg name="spawn_x_pos" value="$(arg spawn_x_pos)" />
    <arg name="spawn_y_pos" value="$(arg spawn_y_pos)" />
    <arg name="spawn_z_pos" value="$(arg spawn_z_pos)" />
    <arg name="spawn_yaw"   value="$(arg spawn_yaw)" />
  </include>-->
    
  <include file="$(find argo_robot_gazebo_description)/launch/publish_ground_truth_state.launch"/> 
  
  <!--Arm Motion planning-->
  <include file="$(find argo_planning_launch)/launch/move_group_$(arg robot_type).launch"/>
  
  <!--LIDAR processing -->
  <include file="$(find hector_argo_tracker_onboard_launch)/launch/lidar_proc/lidar_proc_$(arg robot_type).launch">
    <arg name="lidar_filter_target_frame" value="$(arg lidar_filter_target_frame)"/>
  </include>
  
  <!-- vehicle controller -->
  <include file="$(find argo_nav_launch)/launch/navigation.launch"/>
  
  <!-- TSDF -->
  <include file="$(find whole_body_posture_optimization)/launch/tsdf_server.launch"/>

  
  <!-- Gazebo -->
  <include file="$(find argo_robot_gazebo_description)/launch/spawn_$(arg robot_type).launch">
    <arg name="spawn_x_pos" value="$(arg spawn_x_pos)" />
    <arg name="spawn_y_pos" value="$(arg spawn_y_pos)" />
    <arg name="spawn_z_pos" value="$(arg spawn_z_pos)" />
    <arg name="spawn_roll"  value="$(arg spawn_roll)" />
    <arg name="spawn_pitch" value="$(arg spawn_pitch)" />
    <arg name="spawn_yaw"   value="$(arg spawn_yaw)" />
  </include>
  
  <param name="/use_sim_time" value="true" />

  <node name="gazebo" pkg="gazebo_ros" type="gzserver" args="$(arg world)" respawn="false" output="screen"/>
  
  <!-- start gui -->
  <node name="gazebo_gui" pkg="gazebo_ros" type="gzclient" respawn="false" output="screen"/>
  
</launch>

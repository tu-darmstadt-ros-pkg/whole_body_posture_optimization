<?xml version="1.0"?>

<launch>
  <arg name="robot_type" default="argo_tracker" />
  <arg name="lidar_filter_target_frame" default="odom"/>

  <arg name="spawn_x_pos" default="0" />
  <arg name="spawn_y_pos" default="0" />
  <arg name="spawn_z_pos" default="0.1" />
  <arg name="spawn_roll"  default="0.0" />
  <arg name="spawn_pitch" default="0.0" />    
  <arg name="spawn_yaw"   default="0" />
  
  <arg name="world" default="step.world"/>
    
<!--   <include file="$(find argo_robot_gazebo_description)/launch/publish_ground_truth_state.launch"/>  -->
  <include file="$(find inspection_onboard_launch)/launch/publish_ground_truth_state.launch"/>
  
  <!--Arm Motion planning-->
  <include file="$(find argo_tracker_onboard_launch)/launch/onboard_move_group.launch"/>
  
  <!-- Navigation-->
  <include file="$(find argo_nav_launch)/launch/navigation.launch">
    <arg name="narrow_space_penalty_weight" value="0.02" />
  </include>
  
  <!-- Lidar processing -->  
  <include file="$(find hector_sensor_proc_launch)/launch/nodelet_lidar_proc.launch">
    <arg name="robot_description_containment_filter" value="$(find xacro)/xacro --inorder $(find argo_tracker_description)/urdf/argo_tracker_default.urdf.xacro add_self_filter_geom:=true"/>
    <arg name="robot_description_raycast_filter" value="$(find xacro)/xacro --inorder $(find argo_tracker_description)/urdf/argo_tracker_default.urdf.xacro add_self_filter_geom:=false"/>
    <arg name="containment_self_filter_config" value="$(find hector_tracked_vehicles_self_filter)/config/self_filter_argo_tracker.yaml" />
    <arg name="raycast_self_filter_config" value="$(find hector_tracked_vehicles_self_filter)/config/raycast_self_filter_argo_tracker.yaml" />    
  </include>
  
  <node pkg="vigir_cloud_to_planar_scan" type="periodic_cloud_aggregator_node" name="laserscan_to_aggregated_cloud" output="screen" respawn="true">
    <remap from="cloud" to="/scan_cloud_filtered" />
    <remap from="cloud_out" to="/scan_cloud_aggregated" />    
    <param name="publish_frequency_hz" value="0.5" />
    <param name="target_frame" value="odom" />
    <param name="publish_frame" value="spin_lidar_lidar_mount_link_fixed" />
    <param name="actuated_joint_name" value="spin_lidar_spin_joint" />
    <param name="actuated_joint_min_velocity" value="0.0" />
  </node>  
  
  <!--LIDAR processing -->
<!--  <include file="$(find hector_argo_tracker_onboard_launch)/launch/lidar_proc/lidar_proc_$(arg robot_type).launch">
    <arg name="lidar_filter_target_frame" value="$(arg lidar_filter_target_frame)"/>
  </include>-->
  
  <!-- depth cam self filter -->
<!--   <include file="$(find hector_argo_tracker_onboard_launch)/launch/depth_proc/realsense_box_filter.launch"/> -->
  
  <!-- vehicle controller -->
<!--   <include file="$(find argo_nav_launch)/launch/navigation.launch"/> -->
  
  <!-- TSDF -->
  <include file="$(find whole_body_posture_optimization)/launch/tsdf_server.launch"/>
  
  <!-- Gazebo -->
  <include file="$(find argo_robot_gazebo_description)/launch/spawn_$(arg robot_type).launch">
    <arg name="spawn_x_pos" value="$(arg spawn_x_pos)" />
    <arg name="spawn_y_pos" value="$(arg spawn_y_pos)" />
    <arg name="spawn_z_pos" value="$(arg spawn_z_pos)" />
    <arg name="spawn_roll"  value="$(arg spawn_roll)" />
    <arg name="spawn_pitch" value="$(arg spawn_pitch)" />
    <arg name="spawn_yaw"   value="$(arg spawn_yaw)" />
  </include>
  
  <param name="/use_sim_time" value="true" />

  <node name="gazebo" pkg="gazebo_ros" type="gzserver" args="$(find whole_body_posture_optimization)/worlds/$(arg world) --verbose --pause" respawn="false" output="screen"/>
  
  <!-- start gui -->
  <node name="gazebo_gui" pkg="gazebo_ros" type="gzclient" respawn="false" output="screen"/>
  
</launch>

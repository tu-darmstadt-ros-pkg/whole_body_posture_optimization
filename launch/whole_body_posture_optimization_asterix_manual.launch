<?xml version="1.0"?>
<launch>  
  <!-- Load robot description -->
  <param name="robot_description" command="$(find xacro)/xacro --inorder $(find asterix_description)/urdf/asterix_ugv.urdf.xacro" />
  <param name="robot_description_semantic" textfile="$(find asterix_moveit_config)/config/asterix_ugv.srdf" />
  
  <!-- Joint state UI -->
  <rosparam subst_value="true">
    zeros:
      arm_joint_0: 1.57
      arm_joint_1: -1.57
      arm_joint_2: 1.49
      arm_joint_3: -1.57
      arm_joint_4: -1.30
      arm_joint_5: 0.05
      flipper_front_joint: 0
      flipper_back_joint: 0
<!--      arm_joint_0: 0
      arm_joint_1: 0
      arm_joint_2: 0
      arm_joint_3: 0
      arm_joint_4: 0
      arm_joint_5: 0.05
      flipper_front_joint: 0
      flipper_back_joint: 0-->
  </rosparam>
  <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" />
  
  <!-- Robot pose interactive marker -->
  <node pkg="vigir_interactive_marker_pose_server" type="interactive_marker_pose_server" name="robot_pose_interactive_marker" output="screen" 
      ns="whole_body_posture_optimization_node/interactive_marker">
    <remap from="pose" to="set_robot_pose"/>
    <param name="marker_name" value="robot_pose" />
    <param name="frame_id" value="world" /> 

    <remap from="~init_pose" to="/whole_body_posture_optimization_node/robot_pose"/>
  </node> 
  
  <node pkg="whole_body_posture_optimization" type="manual_control_node" name="whole_body_posture_optimization_node" output="screen" clear_params="true">
    <!-- node parameters -->
    <rosparam subst_value="true">
<!--      robot_pose: [0.763857, 0.000000, 0.210394, -0.006555, -0.005378, 0.000000]-->
<!--       robot_pose: [0.287019, 0.000000, -1.323822, 0.000000, -0.000000, 0.000000]  -->
<!--       robot_pose: [0.574219, 0.000000, -1.249656, 0.000000, -0.000000, 0.000000] -->
<!--       robot_pose: [1.129280, 0.000000, -1.078778, 0.000000, -0.000000, 0.000000] -->
<!--       robot_pose: [0.350860, 0.000000, -1.323822, 0.000000, -0.000000, 0.000000] # step: shortly after first contact with step -->
<!--       robot_pose: [0.265203, 0.000000, -1.323822, 0.000000, -0.000000, 0.000000] # step: slightly on step -->
<!--       robot_pose: [0.480000, 0.000000, -1.928082, -0.000000, 0.007765, 0.000000] # step: a lot of qhull errors -->

<!--       robot_pose: [0.814453, 0.022880, -1.321568, 0.000000, -0.000000, 1.557972] # step: sideways on step -->
<!--       robot_pose: [0.204386, 0.000000, -1.323822, 0.000000, -0.000000, 0.000000] # first contact with step -->
<!--       robot_pose: [2.469902, 0.000000, 1.947217, 0.000000, -0.000000, 0.000000] -->
      robot_pose: [0,0,0,0,0,0] # gazebo asym
      
    </rosparam>
    
    <param name="scenario" value="sdf"/>
    <!--     <param name="sdf_file_path" value="$(find sdf_contact_estimation)/sdf/real_robot1.esdf"/> -->
        <param name="sdf_file_path" value="$(find sdf_contact_estimation)/sdf/gazebo_step.esdf"/>
    <!--     <param name="sdf_file_path" value="$(find sdf_contact_estimation)/sdf/gazebo_highstep.esdf"/> -->
<!--         <param name="sdf_file_path" value="$(find sdf_contact_estimation)/sdf/gazebo_ramp.esdf"/> -->
    <!--         <param name="sdf_file_path" value="$(find sdf_contact_estimation)/sdf/gazebo_cinder_block.esdf"/> -->
<!--     <param name="sdf_file_path" value="$(find sdf_contact_estimation)/sdf/gazebo_asym.esdf"/> -->
<!--     <param name="sdf_file_path" value="$(find sdf_contact_estimation)/sdf/gazebo_mob4.esdf"/> -->
    <param name="stability_info_save_folder" value="$(find whole_body_posture_optimization)/data/planning"/>
    
    <!-- posture optimization lib parameters -->
<!--     <param name="sdf_save_folder" value="$(find sdf_contact_estimation)/sdf"/> -->
    <rosparam file="$(find whole_body_posture_optimization)/config/opt_asterix.yaml" command="load" />  
    
    <!-- contact estimation lib parameters -->
    <rosparam file="$(find sdf_contact_estimation)/config/optimization.yaml" command="load" ns="contact_estimation"/>
    <rosparam file="$(find sdf_contact_estimation)/config/asterix_shape_config.yaml" command="load" />  
    
    <remap from="~set_robot_pose" to="/whole_body_posture_optimization_node/interactive_marker/set_robot_pose"/>
  </node>
</launch>

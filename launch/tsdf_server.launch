<?xml version="1.0"?>
<launch> 
    <node name="tsdf_server" pkg="voxblox_ros" type="tsdf_server" respawn="true" output="screen">
    <param name="world_frame" value="world"/>
    <param name="publish_tsdf_map" value="false"/>
    <param name="update_mesh_every_n_sec" value="1.0" />
    
    <param name="publish_tsdf_info" value="false" />
    <param name="min_time_between_msgs_sec" value="0.0" />
    <param name="verbose" value="false" />
    <param name="color_mode" value="normals" />
    <param name="method" value="simple" />
    
    <param name="tsdf_voxel_size" value="0.025" />
    <param name="tsdf_voxels_per_side" value="16" />
    <param name="voxel_carving_enabled" value="true" />
    <param name="truncation_distance" value="0.4" />

<!--     <remap from="pointcloud" to="/scans_combined"/> -->
    <remap from="pointcloud" to="/scan_cloud_filtered"/>
    
    <!--<remap from="pointcloud" to="/arm_rgbd_cam/depth/points"/>-->
  </node>
  
  <node name="filtered_laser_relay" pkg="topic_tools" type="relay" args="/scan_cloud_filtered /scans_combined">
    <param name="lazy" value="true"/>
  </node>
  
  <node name="depth_cam_relay" pkg="topic_tools" type="relay" args="/arm_rgbd_cam/depth/points /scans_combined">
    <param name="lazy" value="true"/>
  </node>
</launch>
<?xml version="1.0"?>
<launch>  
  <param name="robot_description" command="$(find xacro)/xacro --inorder $(find argo_tracker_description)/urdf/argo_tracker_default.urdf.xacro" />
  <param name="robot_description_semantic" textfile="$(find argo_tracker_robot_moveit_config)/config/taurob_tracker.srdf" />
  
    <node pkg="vigir_interactive_marker_pose_server" type="interactive_marker_pose_server" name="robot_pose_interactive_marker" output="screen" 
      ns="whole_body_posture_optimization_node/interactive_marker">
    <remap from="pose" to="set_robot_pose"/>
    <param name="marker_name" value="robot_pose" />
    <param name="frame_id" value="world" /> 
    <rosparam subst_value="true">
      # step
      #init_pose: [0.946, 0, -1.96, 0, 0, 0]
      
      # tsdf
      init_pose: [0, 0, 0.5, 0.000000, 0.000000, 0]
    </rosparam>
  </node> 
  
  <node pkg="whole_body_posture_optimization" type="whole_body_posture_optimization_node" name="whole_body_posture_optimization_node" output="screen">
    <!-- node parameters -->
    <param name="interactive" value="false"/>
    <param name="scenario" value="tsdf"/>
<!--     <param name="tsdf_file_path" value="$(find sdf_contact_estimation)/tsdf/real_robot1.tsdf"/> -->
<!--     <param name="tsdf_file_path" value="$(find sdf_contact_estimation)/tsdf/gazebo_step.tsdf"/> -->
    <param name="tsdf_file_path" value="$(find sdf_contact_estimation)/tsdf/gazebo_ramp.tsdf"/>
<!--     <param name="tsdf_file_path" value="$(find sdf_contact_estimation)/tsdf/gazebo_stairs.tsdf"/> -->
<!--     <param name="tsdf_file_path" value="$(find sdf_contact_estimation)/tsdf/gazebo_cinder_block.tsdf"/> -->
    
    <param name="path_start" value="0.0"/>    
    <param name="path_stop" value="0.93"/>
    <param name="path_step" value="0.02"/>
    
    <!-- posture optimization lib parameters -->
    <param name="posture_optimization_debug" value="false"/>
<!--     <param name="debug_computation_rate" value="0"/> -->
<!--     <param name="tsdf_save_folder" value="$(find whole_body_posture_optimization)/tsdf"/> -->
    <param name="tsdf_save_folder" value=""/>
    <rosparam file="$(find whole_body_posture_optimization)/config/opt.yaml" command="load" />  
    
    <!-- contact estimation lib parameters -->
<!--    <param name="contact_estimation_debug" value="false"/>
    <param name="truncation_distance" value="0.4"/>
    <param name="iteration_max_contact_distance" value="0.01"/>
    <param name="final_max_contact_distance" value="0.05"/>  -->
    
    <remap from="~set_robot_pose" to="/whole_body_posture_optimization_node/interactive_marker/set_robot_pose"/>
  </node>
</launch>

<?xml version="1.0"?>
<launch>    
  <node pkg="whole_body_posture_optimization" type="driving_controller_node" name="driving_controller_node" output="screen">
    
<!--     <param name="tsdf_load_path" value=""/> -->
<!--     <param name="tsdf_load_path" value="$(find sdf_contact_estimation)/tsdf/gazebo_sim_vlp16_2.tsdf"/> -->
<!--     <param name="tsdf_load_path" value="$(find sdf_contact_estimation)/tsdf/gazebo_ramp5.tsdf"/> -->
   <param name="tsdf_load_path" value="$(find sdf_contact_estimation)/sdf/gazebo_step.tsdf"/>
<!--     <param name="tsdf_load_path" value="$(find sdf_contact_estimation)/tsdf/gazebo_stairs2.tsdf"/> -->
<!--     <param name="tsdf_load_path" value="$(find sdf_contact_estimation)/tsdf/gazebo_asym2.tsdf"/> -->
    
    <param name="path_start" value="-0.2"/>    
    <param name="path_stop" value="0.5"/>
    <param name="path_step" value="0.02"/>
    
    <!-- posture optimization lib parameters -->
<!--     <param name="tsdf_save_folder" value="$(find whole_body_posture_optimization)/tsdf"/> -->
    <rosparam file="$(find whole_body_posture_optimization)/config/opt_telemax.yaml" command="load" />
    <rosparam file="$(find sdf_contact_estimation)/config/optimization.yaml" command="load" />  
    <rosparam file="$(find sdf_contact_estimation)/config/telemax_shape_config.yaml" command="load" />  
    
    <param name="stability_info_save_folder" value="$(find whole_body_posture_optimization)/data/planning"/>
    
    <remap from="~tsdf" to="/tsdf_server/tsdf_map_out"/>
    <remap from="~get_tsdf" to="/tsdf_server/get_map"/>
    
  </node>
</launch>

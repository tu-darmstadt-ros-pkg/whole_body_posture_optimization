<?xml version="1.0"?>
<launch>
  <arg name="telemax_config" default="telemax_2f"/>
  
  <node pkg="whole_body_posture_optimization" type="driving_controller_node" name="driving_controller_node" output="screen">
    
<!--     <param name="tsdf_load_path" value=""/> -->
<!--     <param name="tsdf_load_path" value="$(find sdf_contact_estimation)/tsdf/gazebo_sim_vlp16_2.tsdf"/> -->
<!--     <param name="tsdf_load_path" value="$(find sdf_contact_estimation)/sdf/gazebo_ramp.tsdf"/> -->
   <param name="tsdf_load_path" value="$(find sdf_contact_estimation)/sdf/gazebo_step.tsdf"/>
<!--     <param name="tsdf_load_path" value="$(find sdf_contact_estimation)/tsdf/gazebo_stairs2.tsdf"/> -->
<!--     <param name="tsdf_load_path" value="$(find sdf_contact_estimation)/tsdf/gazebo_asym2.tsdf"/> -->
    
    <!-- STEP -->
    <param name="path_start" value="-0.3"/>
    <param name="path_stop" value="2.5"/>
    <param name="path_step" value="0.02"/>
    
    <!-- RAMP -->
<!--    <param name="path_start" value="0.0"/>
    <param name="path_stop" value="5"/>
    <param name="path_step" value="0.02"/>-->

    <!-- CINDER BLOCK -->
<!--    <param name="path_start" value="-0.3"/>
    <param name="path_stop" value="2"/>
    <param name="path_step" value="0.02"/>-->

    <!-- ASYM STEP -->
<!--    <param name="path_start" value="-0.3"/>
    <param name="path_stop" value="2.5"/>
    <param name="path_step" value="0.02"/>-->

    <!-- posture optimization lib parameters -->
    <!-- posture optimization lib parameters -->
    <param name="stepping" value="false"/>
    <param name="stepping_start" value="43"/>
    <!--     <param name="sdf_save_folder" value="$(find sdf_contact_estimation)/sdf"/> -->
    <param name="sdf_save_folder" value=""/>
    <rosparam file="$(find whole_body_posture_optimization)/config/opt_$(arg telemax_config).yaml" command="load" />  
    
    <!-- contact estimation lib parameters -->
    <rosparam file="$(find sdf_contact_estimation)/config/optimization.yaml" command="load" ns="contact_estimation"/>
    <rosparam file="$(find sdf_contact_estimation)/config/$(arg telemax_config)_shape_config.yaml" command="load" />      
    
    <param name="stability_info_save_folder" value="$(find whole_body_posture_optimization)/data/planning"/>
    
    <remap from="~tsdf" to="/tsdf_server/tsdf_map_out"/>
    <remap from="~get_tsdf" to="/tsdf_server/get_map"/>
    
  </node>
</launch>
